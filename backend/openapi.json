  "components": {
    "schemas": {
      "GearItemIn": {
        "properties": {
          "item_key": {
            "type": "string",
            "title": "Item Key"
          },
          "model_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id"
          },
          "custom_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 48
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Name"
          }
        },
        "type": "object",
        "required": [
          "item_key"
        ],
        "title": "GearItemIn"
      },
      "GearItemOut": {
        "properties": {
          "item_key": {
            "type": "string",
            "title": "Item Key"
          },
          "model_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id"
          },
          "custom_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Name"
          }
        },
        "type": "object",
        "required": [
          "item_key",
          "model_id",
          "custom_name"
        ],
        "title": "GearItemOut"
      },
      "GearListIn": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/GearItemIn"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "GearListIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginIn": {
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "password"
        ],
        "title": "LoginIn"
      },
      "LogoutOut": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          }
        },
        "type": "object",
        "required": [
          "ok"
        ],
        "title": "LogoutOut"
      },
      "ProfileIn": {
        "properties": {
          "sports": {
            "items": {
              "$ref": "#/components/schemas/Sport"
            },
            "type": "array",
            "maxItems": 4,
            "title": "Sports"
          },
          "exp_level": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Exp Level"
          },
          "fitness": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Fitness"
          }
        },
        "type": "object",
        "required": [
          "sports",
          "exp_level",
          "fitness"
        ],
        "title": "ProfileIn"
      },
      "ProfileOut": {
        "properties": {
          "sports": {
            "items": {
              "$ref": "#/components/schemas/Sport"
            },
            "type": "array",
            "title": "Sports"
          },
          "exp_level": {
            "type": "integer",
            "title": "Exp Level"
          },
          "fitness": {
            "type": "integer",
            "title": "Fitness"
          }
        },
        "type": "object",
        "required": [
          "sports",
          "exp_level",
          "fitness"
        ],
        "title": "ProfileOut"
      },
      "RefreshIn": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshIn"
      },
      "RegisterIn": {
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^1\\d{10}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8,
            "title": "Password"
          },
          "nickname": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Nickname"
          }
        },
        "type": "object",
        "required": [
          "password",
          "nickname"
        ],
        "title": "RegisterIn"
      },
      "Sport": {
        "type": "string",
        "enum": [
          "hiking",
          "trail-running",
          "climbing",
          "stream",
          "cycling",
          "camping",
          "skiing",
          "orienteering"
        ],
        "title": "Sport"
      },
      "TokenPair": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "refresh_token"
        ],
        "title": "TokenPair"
      },
      "UserOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "nickname": {
            "type": "string",
            "title": "Nickname"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "phone",
          "nickname"
        ],
        "title": "UserOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
