GL_ENV=dev
GL_DATABASE_URL=postgresql+asyncpg://ganluluo:ganluluo@localhost:5432/ganluluo
GL_JWT_SECRET=please-generate-32-bytes-random-secret
GL_DOCKER_HOST=<docker-host>
GL_PG_URL=<pg-url>
# 管理员种子邮箱（scripts/seed_admin.py 读取；置为已注册用户邮箱并执行一次即授予 is_admin）
# GL_ADMIN_EMAIL=admin@example.com
# MinIO 对象存储（四项齐全启用 MinioMediaStore；否则离线降级 FakeMediaStore，见 app/domains/media/media_store.py）
# GL_MINIO_ENDPOINT=localhost:9000
# GL_MINIO_ACCESS_KEY=minioadmin
# GL_MINIO_SECRET_KEY=minioadmin
# GL_MINIO_BUCKET=media
# GL_MINIO_SECURE=false
# 微信小程序一键登录（两项齐全走真实 jscode2session；缺省 dev 用确定性 mock，prod 未配置 503）
# GL_WECHAT_APPID=wx-your-appid
# GL_WECHAT_SECRET=your-wechat-secret
